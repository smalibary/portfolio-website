# Cloudflare Pages headers — never cache anything on this preview branch.
# https://developers.cloudflare.com/pages/configuration/headers/
#
# Rules are evaluated top-to-bottom; later more-specific rules can
# override. We use a catch-all /* with multiple cache-busting headers,
# then carve out images which are safe to cache.

/*
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0
  Surrogate-Control: no-store

/
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

# Images are safe to cache — they don't change between deploys.
/images/*
  Cache-Control: public, max-age=86400
/favicon.ico
  Cache-Control: public, max-age=86400
