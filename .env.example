# Copy this file to .env and fill in real values. The .env file is gitignored.
#
# Where these are used:
#  - .env (this folder) is for local development scripts and build-time
#    migrations.
#  - Production secrets live on Cloudflare Pages (Pages → salem-portfolio →
#    Settings → Variables and Secrets). See DEPLOY.md.
#  - CLI-tool credentials (SUPABASE_ACCESS_TOKEN, SUPABASE_DB_PASSWORD) live
#    as OS-level env vars on your machine, not here — they're not project-
#    specific.

# ----- Supabase (app runtime) -----
# Find under: Supabase dashboard → Project Settings → Data API
SUPABASE_URL=https://htpycoixfyqjatvtklmh.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key...   # safe to use in browsers
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key...   # NEVER expose to browsers

# ----- Resend (transactional email) -----
# Already set on Cloudflare Pages prod + preview. Duplicate here only if you
# run /api/contact locally during dev.
RESEND_API_KEY=re_...
CONTACT_EMAIL=hey@smalibary.me
